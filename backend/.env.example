OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Free alternative to OpenAI: a Gemini key from Google AI Studio makes every
# AI-written material work at no cost. Sign in with any Google account at
# https://aistudio.google.com/apikey and paste the key here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Second free backup: when Gemini's free daily quota is exhausted, the app
# falls back to Groq automatically. Free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# 14 of the 17 built-in job sources need no keys at all. Seven of them are public
# remote-job feeds (Remotive, Remote OK, Jobicy, Arbeitnow, We Work Remotely,
# Himalayas, Working Nomads), one is the LinkedIn jobs board, three go straight
# to employers that hire in Egypt through their own applicant system (Amazon
# Careers, Workday — Citi, PwC, Unilever, HP, Maersk, Accenture… — and
# SmartRecruiters), one reads the employers whose career boards list roles open
# to worldwide remote applicants (Canonical, Stripe, GitLab, Supabase…), and
# one is Jobgether's remote aggregator feed. Those work from the moment the app
# starts. The three Egyptian channels below stay silent until you set their keys.

# Google for Jobs Egypt (JSearch) is how Wuzzuf / Bayt / GulfTalent postings
# reach the app. It stays switched off until you set this.
# Free sign-up at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch (Basic plan,
# 250 requests a month; the app spends one per import and rotates your phrases).
RAPIDAPI_KEY=

# Jooble, an aggregator of Egyptian job boards. Also optional and silent until
# you set a key — free test token at https://jooble.org/api/about (100 requests
# per hour per key; the app spends one per import and rotates phrases).
JOOBLE_API_KEY=

# Adzuna, another aggregator of Egyptian job boards. Optional and silent until
# you set both values — free key pair at https://developer.adzuna.com (the app
# spends one request per import and rotates phrases, so the free daily allowance
# lasts).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

DATABASE_URL=sqlite:///./jobhunter.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/jobhunter

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=604800
HOST=127.0.0.1
PORT=8000
